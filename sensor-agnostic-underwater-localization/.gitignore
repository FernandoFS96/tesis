# Only code and configuration are tracked. Datasets are regenerated with
# data/generate.py and data/process_data.py; training runs and evaluation
# results go to output/.

/*
!/.gitignore
!/README.md
!/splits/
!/requirements.txt
!/config/
!/src/
!/scripts/
!/data/
!/paper/

# data/: generation and processing code only
/data/*
!/data/*.py

# paper/: table and figure scripts only
/paper/*
!/paper/scripts/

*.bak
__pycache__/
*.py[cod]
*.log
*.out
*.wandb
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz
*.h5
*.pdf
*.png
*.zip
