# Only the project folders listed here are tracked. What is tracked inside each
# one is decided by that project's own .gitignore.
/*
!/.gitignore
!/underwater-localization/
!/underwater-localization-topologies/
!/magnetic-localization/

# Everywhere: caches, logs and model weights
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.wandb
*.pt
*.pth
*.pth.tar
*.ckpt

# Shell launchers carry machine-specific paths
*.sh
