# Ignore everything in the root folder
/*

# Except the underwater-localization folder
!/underwater-localization/
underwater-localization/results/
underwater-localization/data/high_variance/data_processed/
underwater-localization/data/low_variance/data_processed/

# Except the magnetic-localization folder
!/magnetic-localization/
magnetic-localization/data/simulated_data/
magnetic-localization/data/trajectories/
magnetic-localization/training/np_magnetic_runs/
magnetic-localization/2025-jmse.pdf

# Except the underwater-localization folder
!/underwater-localization-topologies/
underwater-localization-topologies/data/data_save_2/
underwater-localization-topologies/data/data_save_ranp_paper/
underwater-localization-topologies/data/data/channel*
underwater-localization-topologies/data/data/data_*
underwater-localization-topologies/src/training/results/
underwater-localization-topologies/src/training/nohup*
underwater-localization-topologies/src/training/optuna*.log
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_ellipsoidal/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_ellipsoidal/model_anp/checkpoints/
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_aligned/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_aligned/model_anp/checkpoints/
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_random/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/finetune_ood/topology_random/model_anp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_ellipsoidal/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_ellipsoidal/model_anp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_aligned/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_aligned/model_anp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_random/model_ranp/checkpoints/
underwater-localization-topologies/src/evaluation/results/explore_lora/topology_random/model_anp/checkpoints/
underwater-localization-topologies/2026-joe.pdf
underwater-localization-topologies/RANP_Underwater_Localization_Manuscrpt.pdf

# except the KIT-ALR collaboration. What it publishes is decided by its own
# whitelist, sensor-agnostic-underwater-localization/.gitignore.
!/sensor-agnostic-underwater-localization/
# wandb raw run logs are large binaries — never commit them (GitHub 100MB limit)
*.wandb

# Python bytecode / caches — generated, never commit (any subproject, any depth)
__pycache__/
*.py[cod]
*.sh
